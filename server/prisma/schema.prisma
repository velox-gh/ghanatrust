generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  PRICE_AGREED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  PAID
  REVIEWED
  CANCELLED
}

enum DisputeType {
  CUSTOMER_COMPLAINT
  PROVIDER_COMPLAINT
}

enum DisputeStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String?
  googleId     String?  @unique
  firstName    String
  lastName     String
  phoneNumber  String?
  role         UserRole @default(CUSTOMER)
  profileImage String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  provider         Provider?
  bookings         Booking[]
  reviewsGiven     Review[]       @relation("CustomerReviews")
  messagesSent     Message[]      @relation("SentMessages")
  messagesReceived Message[]      @relation("ReceivedMessages")
  notifications    Notification[]
  raisedDisputes   Dispute[]         @relation("RaisedDisputes")
  resolvedDisputes Dispute[]         @relation("ResolvedDisputes")
  assignedDisputes Dispute[]         @relation("AssignedDisputes")
  uploadedEvidence DisputeEvidence[]
  verificationRequests VerificationRequest[]
  auditLogs        AuditLog[]    @relation("AdminAuditLogs")

  @@map("users")
}

model Provider {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  businessName     String?
  description      String?
  experienceYears  Int?
  trustScore       Float    @default(0)
  jobsCompleted    Int      @default(0)
  completionRate   Float    @default(0)
  identityVerified Boolean  @default(false)
  phoneVerified    Boolean  @default(false)
  skillsVerified   Boolean  @default(false)
  locationVerified Boolean  @default(false)
  subscriptionTier      String    @default("FREE") // FREE | PRO | FEATURED
  subscriptionExpiresAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  user                 User                  @relation(fields: [userId], references: [id])
  services             ProviderService[]
  locations            ProviderLocation[]
  portfolio            PortfolioItem[]
  bookings             Booking[]
  reviews              Review[]              @relation("ProviderReviews")
  verificationRequests VerificationRequest[]
  subscriptions        Subscription[]

  @@map("providers")
}

model ProviderService {
  id         Int      @id @default(autoincrement())
  providerId Int
  serviceId  Int
  price      Float?
  priceUnit  String? // "per hour", "per job", etc.
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  provider Provider @relation(fields: [providerId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  @@map("provider_services")
}

model ProviderLocation {
  id         Int      @id @default(autoincrement())
  providerId Int
  locationId Int
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Relations
  provider Provider @relation(fields: [providerId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@map("provider_locations")
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  categoryId  Int
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  category         Category          @relation(fields: [categoryId], references: [id])
  providerServices ProviderService[]
  bookings         Booking[]

  @@map("services")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  services Service[]

  @@map("categories")
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String
  regionId  Int?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  region            Region?            @relation(fields: [regionId], references: [id])
  providerLocations ProviderLocation[]
  bookings          Booking[]

  @@map("locations")
}

model Region {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  locations Location[]

  @@map("regions")
}

model VerificationRequest {
  id          Int                @id @default(autoincrement())
  providerId  Int
  userId      Int
  type        String // "IDENTITY", "SKILLS", "LOCATION"
  status      VerificationStatus @default(PENDING)
  documentUrl String?
  notes       String?
  adminNotes  String?
  submittedAt DateTime           @default(now())
  reviewedAt  DateTime?
  reviewedBy  Int?

  // Relations
  provider Provider @relation(fields: [providerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("verification_requests")
}

model PortfolioItem {
  id          Int      @id @default(autoincrement())
  providerId  Int
  title       String
  description String?
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  provider Provider @relation(fields: [providerId], references: [id])

  @@map("portfolio_items")
}

model Booking {
  id               Int           @id @default(autoincrement())
  customerId       Int
  providerId       Int
  serviceId        Int
  locationId       Int?
  status           BookingStatus @default(REQUESTED)
  scheduledDate    DateTime?
  scheduledEndDate DateTime?
  description      String?
  price            Float?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  customer User      @relation(fields: [customerId], references: [id])
  provider Provider  @relation(fields: [providerId], references: [id])
  service  Service   @relation(fields: [serviceId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])
  payment  Payment?
  review   Review?
  dispute  Dispute?
  messages Message[]

  @@map("bookings")
}

model Payment {
  id                Int       @id @default(autoincrement())
  bookingId         Int       @unique
  amount            Float
  method            String // "MOBILE_MONEY", "CARD", "CASH"
  status            String // "PENDING", "COMPLETED", "FAILED", "REFUNDED"
  transactionId     String?
  mobileMoneyNumber String?
  platformFee       Float?  // commission kept by GhanaTrust
  providerAmount    Float?  // amount - platformFee (due to provider)
  payoutStatus      String? // "PENDING" | "PAID_OUT"
  paymentDate       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Subscription {
  id            Int       @id @default(autoincrement())
  providerId    Int
  plan          String // PRO | FEATURED
  amount        Float
  status        String    @default("PENDING") // PENDING | ACTIVE | FAILED
  transactionId String    @unique // Paystack reference
  startedAt     DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  provider Provider @relation(fields: [providerId], references: [id])

  @@map("subscriptions")
}

model Review {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @unique
  customerId Int
  providerId Int
  rating     Int // 1-5
  comment    String?
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  booking  Booking  @relation(fields: [bookingId], references: [id])
  customer User     @relation("CustomerReviews", fields: [customerId], references: [id])
  provider Provider @relation("ProviderReviews", fields: [providerId], references: [id])

  @@map("reviews")
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  bookingId  Int?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  sender   User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])

  @@map("messages")
}

model Dispute {
  id              Int           @id @default(autoincrement())
  bookingId       Int           @unique
  raisedBy        Int
  assignedAdminId Int?
  resolvedBy      Int?
  type            DisputeType
  reason          String
  description     String?
  status          DisputeStatus @default(OPEN)
  adminNotes      String?
  resolution      String?
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  booking       Booking           @relation(fields: [bookingId], references: [id])
  raiser        User              @relation("RaisedDisputes", fields: [raisedBy], references: [id])
  assignedAdmin User?             @relation("AssignedDisputes", fields: [assignedAdminId], references: [id])
  resolver      User?             @relation("ResolvedDisputes", fields: [resolvedBy], references: [id])
  evidence      DisputeEvidence[]

  @@map("disputes")
}

model DisputeEvidence {
  id          Int      @id @default(autoincrement())
  disputeId   Int
  uploadedBy  Int
  fileUrl     String
  description String?
  createdAt   DateTime @default(now())

  // Relations
  dispute Dispute @relation(fields: [disputeId], references: [id])
  user    User    @relation(fields: [uploadedBy], references: [id])

  @@map("dispute_evidence")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  adminId     Int
  action      String
  targetType  String
  targetId    Int
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  admin User @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@map("audit_logs")
}
