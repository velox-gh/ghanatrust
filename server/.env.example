# ── Core ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Secrets (required — the server refuses to start without these) ──
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d
SESSION_SECRET=

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/ghanatrust"
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ghanatrust

# ── Google Sign-In (optional — omit to disable the Google button) ────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Paystack ────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
COMMISSION_RATE=0.10
PRO_PLAN_PRICE=50
FEATURED_PLAN_PRICE=100

# ── Email (Nodemailer SMTP) ─────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="GhanaTrust <no-reply@ghanatrust.com>"
